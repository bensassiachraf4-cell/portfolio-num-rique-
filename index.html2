
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ISET Révisions</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f3f6fc;color:#172554}
header{background:linear-gradient(120deg,#102b64,#2563eb);color:white;padding:35px 7%;text-align:center}
header h1{font-size:35px;margin:0 0 12px}
nav{background:white;padding:16px;text-align:center;position:sticky;top:0;box-shadow:0 2px 10px #ddd}
nav a{margin:0 12px;color:#1d4ed8;text-decoration:none;font-weight:bold}
main{max-width:1100px;margin:35px auto;padding:0 20px}
.welcome{background:white;padding:25px;border-radius:16px;margin-bottom:25px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px}
.card{background:white;border-radius:15px;padding:24px;box-shadow:0 4px 15px #dce4f2}
.card h3{color:#1d4ed8}
button{background:#2563eb;color:white;border:0;padding:11px 16px;border-radius:8px;cursor:pointer}
input{padding:12px;border:1px solid #ccd5e5;border-radius:8px;width:100%;margin:12px 0}
footer{text-align:center;padding:30px;color:#64748b}
</style>
</head>
<body>
<header>
<h1>📚 ISET Révisions</h1>
<p>Ta plateforme intelligente pour réussir tes études</p>
<p>ISET Nabeul • Informatique Technologique</p>
</header>
<nav>
<a href="#cours">Cours</a>
<a href="#podcasts">Podcasts</a>
<a href="#videos">Vidéos</a>
<a href="#tp">Travaux pratiques</a>
</nav>
<main>
<section class="welcome">
<h2>Bienvenue sur ISET Révisions 👋</h2>
<p>Retrouve tes cours, révise avec des résumés et prépare tes examens.</p>
<input id="search" placeholder="Rechercher une matière..." oninput="filterCourses()">
</section>
<h2 id="cours">📖 Mes matières</h2>
<div class="grid" id="courses">
<div class="card"><h3>💻 Digital Skills</h3><p>Cours et exercices numériques.</p><button onclick="openCourse('Digital Skills')">Ouvrir</button></div>
<div class="card"><h3>🖥️ Fondamentaux IT</h3><p>Ordinateurs, systèmes et réseaux.</p><button onclick="openCourse('Fondamentaux IT')">Ouvrir</button></div>
<div class="card"><h3>⚡ Système électrique</h3><p>Cours et exercices électriques.</p><button onclick="openCourse('Système électrique')">Ouvrir</button></div>
<div class="card"><h3>🧪 Travaux pratiques</h3><p>TP et documents de l'ISET Nabeul.</p><button onclick="openCourse('Travaux pratiques')">Ouvrir</button></div>
<div class="card"><h3>📚 Algorithmique et C</h3><p>Algorithmes et programmation C.</p><button onclick="openCourse('Algorithmique et C')">Ouvrir</button></div>
<div class="card"><h3>📂 Autres cours</h3><p>Ajoute tes propres documents.</p><button onclick="openCourse('Autres cours')">Ouvrir</button></div>
</div>
<h2 id="podcasts">🎧 Podcasts</h2>
<div class="card"><p>Écoute les explications de tes cours ici.</p>
<input type="file" id="audio" accept="audio/*" onchange="playAudio()">
<audio id="player" controls style="width:100%"></audio>
</div>
<h2 id="videos">🎬 Vidéos de révision</h2>
<div class="card"><p>Ajoute une vidéo YouTube en collant son lien :</p>
<input id="youtube" placeholder="Lien YouTube">
<button onclick="showVideo()">Lire la vidéo</button>
<div id="videoBox"></div>
</div>
<h2 id="tp">📁 Importer mes cours PDF</h2>
<div class="card">
<p>Sélectionne tes fichiers PDF pour les consulter.</p>
<input type="file" id="pdf" accept=".pdf" multiple onchange="showPDF()">
<div id="pdfList"></div>
</div>
</main>
<footer>© 2026 ISET Révisions • Plateforme étudiante</footer>
<script>
function openCourse(name){
alert("Bienvenue dans la matière : "+name+". Ajoute tes PDF dans la section Importer mes cours.");
}
function filterCourses(){
let q=document.getElementById("search").value.toLowerCase();
document.querySelectorAll("#courses .card").forEach(c=>{
c.style.display=c.innerText.toLowerCase().includes(q)?"block":"none";
});
}
function playAudio(){
let f=document.getElementById("audio").files[0];
if(f)document.getElementById("player").src=URL.createObjectURL(f);
}
function showPDF(){
let list=document.getElementById("pdfList");
list.innerHTML="";
Array.from(document.getElementById("pdf").files).forEach(f=>{
let url=URL.createObjectURL(f);
let a=document.createElement("a");
a.href=url;a.target="_blank";a.textContent="📄 "+f.name;
a.style.display="block";a.style.margin="12px";
list.appendChild(a);
});
}
function showVideo(){
let link=document.getElementById("youtube").value;
let id=link.match(/(?:v=|youtu.be\/|embed\/)([^&?/]+)/);
if(id)document.getElementById("videoBox").innerHTML='<iframe width="100%" height="315" src="https://www.youtube.com/embed/'+id[1]+'" allowfullscreen></iframe>';
else alert("Lien YouTube invalide");
}
</script>
</body>
</html>
